# ═══════════════════════════════════════════════════════════════
# Bastion - Global Git Ignore
# ═══════════════════════════════════════════════════════════════

# ── Environment & Secrets ──────────────────────────────────────
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.cred
credentials-*

# ── Dependencies ────────────────────────────────────────────────
node_modules/

# ── Build Outputs ───────────────────────────────────────────────
dist/
build/
storybook-static/
*.tsbuildinfo
packages/*/dist/
coverage/
.nyc_output/

# ── Logs & Reports ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
eslint-*.json

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Infrastructure ──────────────────────────────────────────────
**/.terraform/
*.tfstate
*.tfstate.backup
terraform.tfvars
terraform/*.tfvars
terraform/*.tfvars.json
terraform/crash.log
terraform/**/*.tfstate
kubeconfig*
**/kubeconfig*
.kube/
*.sql
*.sql.gz
pg_dump*
pg_dumpall*
*secrets*.yaml
*secrets*.yml
db_data/

# ── IDE, Editor & OS ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ── Cache & Temp ────────────────────────────────────────────────
tmp/
temp/
*.tmp
backups/
.turbo/
.datadog/
.kpatch/

# ── Agent / CLI Artifacts ──────────────────────────────────────
.aider*
.antigravitycli/
.claude/
.agents/
CLAUDE.md
.sonarqube_report/
.code-quality/
.codex/
.continue/
.archive/
.jenkins/
.opencode/

# ── Plans & Local Scripts (not committed) ─────────────────────
.plans/
scripts/ci/sonar-report.js
scripts/ci/scan-repo/
